SERVICENOW_INSTANCE=https://example.service-now.com
SERVICENOW_USERNAME=your_username

# Default credential path: inject a resolved password from your shell or vault.
# Do not commit real passwords.
SERVICENOW_PASSWORD=replace_with_runtime_secret

# Optional 1Password compatibility path. Leave SERVICENOW_PASSWORD unset when using it.
# Plain item IDs use `op item get`; op://vault/item references use `op read`.
# Use OP_VAULT with plain item IDs when `op` is authenticated by service account.
# Set OP_SERVICE_ACCOUNT_TOKEN in the parent environment when using a service account,
# or point OP_SERVICE_ACCOUNT_TOKEN_FILE at an ignored local file containing it.
# If SERVICENOW_USERNAME is unset, the username field is read from the same 1Password item.
# OP_ITEM_ID=op://vault/item
# OP_VAULT=vault
# OP_SERVICE_ACCOUNT_TOKEN_FILE=/path/to/ignored/op-service-account-token

# Optional Service Portal page slug for human-facing record URLs
# (<instance>/<portal>?id=ticket&...). Defaults to the out-of-box "sp" portal
# when unset; override with your instance's custom portal slug.
# SNOW_PORTAL=sp

# Required only for scripts/task_sla_training_smoke.py live runs.
SNOW_SMOKE_ALLOWED_INSTANCE=https://example.service-now.com
SNOW_TASK_SLA_NUMBER=INC0000001
